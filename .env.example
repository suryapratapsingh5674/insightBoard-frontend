# InsightBoard Frontend Environment Variables
# ---------------------------------------------
# In local development:
# Leave as /api (Vite's proxy in vite.config.js forwards /api requests to http://localhost:5000)
VITE_API_BASE_URL=/api

# In Production (e.g. Vercel deployment):
# Set this in your Vercel Project Settings > Environment Variables:
# VITE_API_BASE_URL=https://your-insightboard-backend.onrender.com/api
